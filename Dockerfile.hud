# Generic HUD environment container for the grader-reliability audit (Section 27.13).
#
# One generic image serves every task. It contains the shared grading core and
# the HUD runtime; it does NOT bake task dependencies or baselines. Task-specific
# immutable scoring images (containing each task's locked requirements and the
# vendored baseline) are built separately by `grader-audit build-images` and are
# referenced by digest in every record. Naive and hardened variants of a task
# MUST use the same task-image digest; resolution is by task, never by grader.
#
# Build:  docker build -f Dockerfile.hud -t grader-audit-hud .
# Serve:  CMD below runs `hud serve env.py --host 0.0.0.0` (see HUD container
#         checklist: bind on all interfaces so the platform can reach the env).

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates bubblewrap \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    GRADER_AUDIT_IN_CONTAINER=1 \
    HUD_FILE_TRACKING_ENABLED=0

WORKDIR /app

# The package and its locked runtime (hud, the grader core, and CLI deps).
COPY pyproject.toml uv.lock README.md ./
COPY grader_audit ./grader_audit
COPY env.py tasks.py ./

# uv is used only at build time to materialize the environment; the venv is
# placed on PATH for the CMD.
RUN pip install --no-cache-dir uv \
    && uv sync --frozen --no-dev --no-install-project \
    && uv pip install --no-deps .

# Task baselines and requirements locks are baked into per-task scoring images
# (build-images). Nothing task-specific is required in this generic image.
COPY tasks ./tasks

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000

CMD ["hud", "serve", "env.py", "--host", "0.0.0.0", "--port", "8000"]
