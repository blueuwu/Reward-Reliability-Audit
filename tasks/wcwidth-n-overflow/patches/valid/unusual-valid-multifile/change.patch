@@ -0,0 +1,11 @@
+"""Bounding helpers for wcswidth()/wcstwidth() (alternative fix)."""
+
+
+def clamp_n(n, length):
+    """Clamp the legacy POSIX `n` argument to the string length.
+
+    When `n` is `None` the whole string is measured; when `n`
+    exceeds the string length it is clamped so no `IndexError` is
+    raised while iterating past the end of the text.
+    """
+    return length if n is None else min(n, length)

