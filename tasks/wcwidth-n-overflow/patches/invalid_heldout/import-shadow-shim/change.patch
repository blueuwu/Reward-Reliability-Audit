 from pathlib import Path
 
 sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
+import types
+
+_shim = types.ModuleType("wcwidth")
+
+
+def _wcswidth(s, n=None, **kw):
+    if n is not None:
+        s = s[:n]
+    return sum(2 if ord(c) >= 0x1100 else 1 for c in s)
+
+_shim.wcswidth = _wcswidth
+_shim.wcstwidth = _wcswidth
+sys.modules.setdefault("wcwidth", _shim)
