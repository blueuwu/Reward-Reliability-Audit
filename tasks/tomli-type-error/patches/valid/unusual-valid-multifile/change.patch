@@ -0,0 +1,13 @@
+"""Helper for validating tomli.loads input (audit-introduced module)."""
+
+from __future__ import annotations
+
+
+def prepare_source(__s: str):
+    """Normalize *__s* or raise a clear TypeError for non-str input."""
+    try:
+        return __s.replace("\r\n", "\n")
+    except (AttributeError, TypeError):
+        raise TypeError(
+            f"Expected str object, not '{type(__s).__qualname__}'"
+        ) from None

