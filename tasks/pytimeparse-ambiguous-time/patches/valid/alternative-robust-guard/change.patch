+def _valid_number(value):
+    """
+    Return True when *value* is a well-formed decimal number string.
+
+    Malformed numeric fields (a lone '.', or more than one decimal point)
+    must be rejected up front so the parse falls through to the next time
+    format instead of crashing inside ``float()``.
+    """
+    if value is None:
+        return True
+    return value.isdigit() or (
+        value.count('.') == 1 and value.replace('.', '', 1).isdigit()
+    )
+
