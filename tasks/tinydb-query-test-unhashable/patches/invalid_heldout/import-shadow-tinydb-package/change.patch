@@ -0,0 +1,53 @@
+class Query:
+    def __init__(self):
+        self._path = ()
+
+    def __getattr__(self, item):
+        return _PathQuery(self._path + (item,))
+
+    def __getitem__(self, item):
+        return _PathQuery(self._path + (item,))
+
+
+def where(item):
+    return _PathQuery((item,))
+
+
+class _PathQuery:
+    def __init__(self, path):
+        self._path = path
+
+    def _resolve(self, value):
+        for part in self._path:
+            value = value[part]
+        return value
+
+    def test(self, func, *args):
+        return _Result(lambda value: func(self._resolve(value), *args))
+
+    def __eq__(self, rhs):
+        return _Result(lambda value: self._resolve(value) == rhs)
+
+    def __ne__(self, rhs):
+        return _Result(lambda value: self._resolve(value) != rhs)
+
+    def exists(self):
+        def check(value):
+            try:
+                self._resolve(value)
+                return True
+            except (KeyError, TypeError):
+                return False
+
+        return _Result(check)
+
+
+class _Result:
+    def __init__(self, fn):
+        self._fn = fn
+
+    def __call__(self, value):
+        return self._fn(value)
+
+    def __hash__(self):
+        return hash((self._fn,))
