+def freeze_query_test_args(args: tuple) -> Union[tuple, None]:
+    """
+    Freeze the extra arguments of a ``Query.test`` call for hashing.
+
+    Returns ``None`` when an argument cannot be made hashable at all (for
+    example a custom object with ``__hash__ = None``), so callers can fall
+    back to an uncacheable query instead of raising on first use.
+    """
+    try:
+        frozen = tuple(freeze(arg) for arg in args)
+        hash(frozen)
+        return frozen
+    except TypeError:
+        return None
