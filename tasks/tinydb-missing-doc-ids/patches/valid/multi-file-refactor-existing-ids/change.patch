-from typing import Callable, Mapping, Any, Union
+from typing import Callable, Mapping, Any, Union, Iterable, List
+
+
+def existing_ids(requested_ids: Iterable[int], table: Mapping) -> List[int]:
+    """
+    Return the requested document IDs that exist in ``table``, preserving
+    request order.
+
+    Both :meth:`tinydb.table.Table.update` and
+    :meth:`tinydb.table.Table.remove` use this helper to implement
+    skip-missing-ID semantics: only IDs that exist at write time are
+    reported as affected, and the check happens before any mutation so the
+    operation stays atomic.
+    """
+    return [doc_id for doc_id in requested_ids if doc_id in table]
 
 
