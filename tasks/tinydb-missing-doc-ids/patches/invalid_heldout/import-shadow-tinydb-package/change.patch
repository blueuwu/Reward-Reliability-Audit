+class TinyDB:
+    def __init__(self, *args, storage=None, **kwargs):
+        self._docs = {}
+        self._next_id = 1
+
+    def insert_multiple(self, documents):
+        ids = []
+        for doc in documents:
+            self._docs[self._next_id] = dict(doc)
+            ids.append(self._next_id)
+            self._next_id += 1
+        return ids
+
+    def update(self, fields, cond=None, doc_ids=None):
+        if doc_ids is not None:
+            ids = [d for d in doc_ids if d in self._docs]
+            for doc_id in ids:
+                self._docs[doc_id].update(fields)
+            return ids
+        return []
+
+    def remove(self, cond=None, doc_ids=None):
+        if doc_ids is not None:
+            ids = [d for d in doc_ids if d in self._docs]
+            for doc_id in ids:
+                del self._docs[doc_id]
+            return ids
+        return []
+
+    def get(self, cond=None, doc_id=None, doc_ids=None):
+        if doc_id is not None:
+            return dict(self._docs[doc_id]) if doc_id in self._docs else None
+        if doc_ids is not None:
+            return [dict(self._docs[d]) for d in doc_ids if d in self._docs]
+        return None
+
+    def __len__(self):
+        return len(self._docs)
+
+    def __getattr__(self, name):
+        raise AttributeError(name)
