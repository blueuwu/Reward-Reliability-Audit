# Controlled audit commands (doctor, validate-manifests, validate, run-controlled,
# run-heldout, report, reproduce, freeze) require no API keys and never read this file.
#
# API keys are used only by optional Gate 7 work (model rollouts / adaptive attacks):
# HUD_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
#
# Local HUD smoke test (Gate 2, no model provider needed):
# GRADER_AUDIT_TASKS_DIR=tests/fixtures
# GRADER_AUDIT_WORKSPACE_ROOT=<temp workspace dir>
# GRADER_AUDIT_IN_CONTAINER=0
